# Copy to scripts/.env.release and fill in real values.
# scripts/.env.release is gitignored — never commit credentials.

# Cloudflare R2 (S3-compatible) — see Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=oh-my-just-open
R2_VANITY_URL=https://pub-06563b7bc8e246b69c21fe5af1f67b88.r2.dev

# Notary keychain profile name (created via `xcrun notarytool store-credentials`)
NOTARY_PROFILE=omjo-notary

# Developer ID Application identity (matches the cert in your login keychain)
SIGNING_IDENTITY="Developer ID Application: Neurix (83698ZGFJP)"
